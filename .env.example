# 复制此文件为 .env 并填入真实值（.env 文件不要上传到 Git）

# Flask Session 密钥（随机字符串，越长越安全）
# 不设则自动持久化到 data/.secret_key（重启后 session 不失效）
SECRET_KEY=请替换为随机字符串如: openssl rand -hex 32 的输出

# 默认管理员账号（首次启动且无管理员时生效）
# 不设 ADMIN_PASSWORD 则随机生成并打印到启动日志，请登录后立即修改
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@local.com
ADMIN_PASSWORD=

# 允许跨域携带凭证的前端来源（逗号分隔），不设则仅同源
CORS_ORIGINS=

# AI 配置（优先级高于网页设置）
AI_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=moonshotai/kimi-k2-6
