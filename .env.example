# 复制此文件为 .env 并填入真实值（.env 文件不要上传到 Git）

# ── 交易模式（危险开关，默认全部安全侧）──────────────────────
# ⚠️ 不设置以下变量 = 模拟盘模式，绝不触碰真实资金。
# QUANT_LIVE_TRADING=1        实盘总开关（原 config.py DRY_RUN=False 的替代）
# QUANT_AUTO_CONFIRM_ORDER=1  委托自动按 Y 确认 → 真成交！需与实盘开关同时设置才生效
# QUANT_AUTO_CANCEL_UNFILLED=1  下单 N 秒未成交自动撤单（同样需实盘开关）
# QUANT_MAX_ORDER_AMOUNT=50000  单笔买入金额上限（元），不设默认 50000
QUANT_LIVE_TRADING=0

# Flask Session 密钥（随机字符串，越长越安全）
# 不设则自动持久化到 data/.secret_key（重启后 session 不失效）
SECRET_KEY=请替换为随机字符串如: openssl rand -hex 32 的输出

# 默认管理员账号（首次启动且无管理员时生效）
# 不设 ADMIN_PASSWORD 则随机生成并打印到启动日志，请登录后立即修改
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@local.com
ADMIN_PASSWORD=

# 允许跨域携带凭证的前端来源（逗号分隔），不设则仅同源
CORS_ORIGINS=

# ── 调度进程拆分（工单5）────────────────────────────────────────
# THS_EMBED_SCHEDULER=0 → Web 只跑交易组调度（扫描/Vibe），数据组
#   （新闻/复盘/概念/AI因子挖掘）由独立进程 scheduler_main.py 承担。
#   本机 launcher.py 自动按拆分模式双进程启动，无需手动设置；
#   云端在 systemd 单元里设置（见 deploy/quant-scheduler.service 头部说明）。
# 不设置 = 单进程全启动（旧行为）。
# THS_EMBED_SCHEDULER=1

# ── 安全加固开关（详见 app_security.py）────────────────────────
# ⚠️ 仅在站点已上 HTTPS 后才设为 1；否则浏览器在 HTTP 下不回传 Secure Cookie → 全员登录失效
# 这里默认 0 是为了本机 http://127.0.0.1 开发；**云端必须是 1**
#（deploy/server_init.sh 与 deploy/deploy.sh 生成 .env 时会自动覆盖成 1）。
# 为 0 时 Strict-Transport-Security 也不会下发，见 app_security.py。
SESSION_COOKIE_SECURE=0
# 登录会话有效期（天），默认 30
SESSION_DAYS=30
# 登录防爆破：窗口内失败次数达上限即临时锁定
LOGIN_MAX_FAILS=5
LOGIN_FAIL_WINDOW=900
LOGIN_LOCK_SECONDS=900
# Swagger API 文档：生产默认关闭，本地调试可设 1 打开 /apidocs/
ENABLE_SWAGGER=0

# ── 找回密码邮件（SMTP）────────────────────────────────────────
# 重置链接里的站点根地址
APP_BASE_URL=https://jwalpha.top
# 发信邮箱（QQ/163/Gmail 等）。SMTP_PASSWORD 填邮箱「授权码」而非登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=见微 Alpha
SMTP_SSL=1

# AI 配置（优先级高于网页设置）
AI_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=moonshotai/kimi-k2-6
# Tushare Replay data source. Put the real key only in .env or cloud env vars.
TUSHARE_REPLAY_API_KEY=
# Optional override when the Replay endpoint changes; defaults try ai-tool.indevs.in compatible paths.
TUSHARE_REPLAY_BASE_URL=

