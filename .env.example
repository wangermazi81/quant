# 复制此文件为 .env 并填入真实值（.env 文件不要上传到 Git）

# Flask Session 密钥（随机字符串，越长越安全）
# 不设则自动持久化到 data/.secret_key（重启后 session 不失效）
SECRET_KEY=请替换为随机字符串如: openssl rand -hex 32 的输出

# 默认管理员账号（首次启动且无管理员时生效）
# 不设 ADMIN_PASSWORD 则随机生成并打印到启动日志，请登录后立即修改
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@local.com
ADMIN_PASSWORD=

# 允许跨域携带凭证的前端来源（逗号分隔），不设则仅同源
CORS_ORIGINS=

# ── 安全加固开关（详见 app_security.py）────────────────────────
# ⚠️ 仅在站点已上 HTTPS 后才设为 1；否则浏览器在 HTTP 下不回传 Secure Cookie → 全员登录失效
SESSION_COOKIE_SECURE=0
# 登录会话有效期（天），默认 30
SESSION_DAYS=30
# 登录防爆破：窗口内失败次数达上限即临时锁定
LOGIN_MAX_FAILS=5
LOGIN_FAIL_WINDOW=900
LOGIN_LOCK_SECONDS=900
# Swagger API 文档：生产默认关闭，本地调试可设 1 打开 /apidocs/
ENABLE_SWAGGER=0

# ── 找回密码邮件（SMTP）────────────────────────────────────────
# 重置链接里的站点根地址
APP_BASE_URL=https://jwalpha.top
# 发信邮箱（QQ/163/Gmail 等）。SMTP_PASSWORD 填邮箱「授权码」而非登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=见微 Alpha
SMTP_SSL=1

# AI 配置（优先级高于网页设置）
AI_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=moonshotai/kimi-k2-6
